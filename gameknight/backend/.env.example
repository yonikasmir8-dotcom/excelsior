PORT=4000
# Comma-separated usernames that get admin rights (list + resolve events).
# If empty, the first account ever registered becomes admin.
ADMIN_USERS=admin
FRONTEND_URL=http://localhost:5174
# Where the SQLite file lives — point at a mounted volume in production
# DB_PATH=/data/gameknight.db

# Live fixtures + auto-resolution from football-data.org (free key: https://www.football-data.org/client/register)
# When set, demo seeding is skipped and real upcoming matches are listed automatically.
# FOOTBALL_DATA_TOKEN=
# FEED_COMPETITIONS=PL,PD,SA,BL1,FL1,CL
# FEED_DAYS_AHEAD=10
# FEED_INTERVAL_MIN=10

# Set to false to skip demo data on an empty database
SEED_DEMO=true

# ── Real money (locked until licensed — see launch/PLAYBOOK.md) ──────────────
# MONEY_MODE=play                 # play (Knight Coins) | real (GBP)
# TAKER_FEE_BPS=200               # platform fee on the taker's cash, in basis points (200 = 2%)
# OPERATOR_LEGAL_NAME=            # required for real money
# LICENCE_NUMBER=                 # Gambling Commission account number — required for real money
# PAYMENTS_PROVIDER=sandbox       # adapter name in backend/money.js
# KYC_PROVIDER=sandbox
# EXCLUSION_PROVIDER=sandbox      # GAMSTOP adapter in production
# ALLOW_SANDBOX_PROVIDERS=false   # true only for local end-to-end testing of real-money mode
# HOUSE_MARKET_MAKER=false        # real money: house quoting makes you a principal…
# GENERAL_BETTING_LICENCE=        # …so it needs a general betting licence too
# ALLOWED_COUNTRIES=GB
# GEO_ENFORCE=false               # true behind Cloudflare (reads cf-ipcountry)
# MIN_DEPOSIT=500  MAX_DEPOSIT=500000  MIN_WITHDRAWAL=1000   # pence
# FVC_THRESHOLD=15000             # financial vulnerability check: net deposits / 30 days (pence)
# FRA_24H_THRESHOLD=100000  FRA_90D_THRESHOLD=300000
