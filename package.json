{
  "name": "the-forgotten-tavern",
  "version": "0.1.0",
  "private": true,
  "description": "The Forgotten Tavern \u2014 a blocky comic-book multiverse RPG",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "desktop": "vite build && electron .",
    "package": "vite build && electron-builder",
    "test:saves": "node tests/save-integrity.mjs"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "playwright": "^1.63.0",
    "vite": "^5.4.0"
  },
  "build": {
    "appId": "com.forgottentavern.game",
    "productName": "The Forgotten Tavern",
    "files": [
      "dist/**",
      "electron/**"
    ],
    "directories": {
      "output": "release"
    }
  }
}
